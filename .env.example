# Flattrade API Credentials
FLATTRADE_USER_ID=your_user_id
FLATTRADE_API_KEY=your_api_key
FLATTRADE_API_SECRET=your_api_secret
FLATTRADE_TOTP_KEY=your_totp_secret_key

# Discord Webhook Notification URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_token

# Discord Gateway control bot (keep token secret; do not commit .env)
DISCORD_CONTROL_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=1535333072352837643
DISCORD_GUILD_ID=
DISCORD_CONTROL_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# Environment Paths
AMMU_DIR=C:/Websites/ammu

# Bot process schedule and timezone
BOT_START_TIME=09:15
BOT_STOP_TIME=15:00
BOT_START_GRACE_MINUTES=5
BOT_VISIBLE_CONSOLE=false
TRADING_TIMEZONE=Asia/Kolkata

[Unit]
Description=Flattrade Last Hope Winner Live Trading Bot (tmux attachable)
After=network.target network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
# tmux daemonizes cleanly: new-session client exits, tmux server keeps running in this cgroup.
# Bot runs DIRECTLY on the tmux PTY (no tee pipe) so stdout is a real TTY -> dashboard renders.
# File logging handled by the bot's own FileHandler -> logs/last_hope_bot.log
Type=forking
User=ubuntu
WorkingDirectory=/home/ubuntu/FLATTRADE_BOT
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/FLATTRADE_BOT
ExecStart=/usr/bin/tmux new-session -s bot -d 'cd /home/ubuntu/FLATTRADE_BOT && python3 -m flattrade_bot.main --live'
ExecStop=/usr/bin/tmux kill-session -t bot
# always (not on-failure): tmux server exits 0 even when the bot dies, so
# on-failure would never fire. 'always' still respects clean 'systemctl stop'.
Restart=always
RestartSec=10s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
